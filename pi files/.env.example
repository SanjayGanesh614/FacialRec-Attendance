# ─────────────────────────────────────────────
# .env.example
# Copy this to .env and fill in your real values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── ERP Connection ─────────────────────────────
ERP_BASE_URL=http://your-erp-server.com
ERP_API_KEY=your-secret-api-key-here
DEVICE_ID=pi-door-01

# ── Recognition Tuning ─────────────────────────
# Raise this if you get false positives (wrong person accepted)
# Lower this if real employees keep getting rejected
RECOGNITION_THRESHOLD=0.50

# Raise this to be stricter about liveness
# Lower this if real faces are being flagged as spoofs
LIVENESS_THRESHOLD=0.60

# ── Hardware ───────────────────────────────────
CAMERA_INDEX=0
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_ENABLED=true

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO
