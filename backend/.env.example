# .env.example
# Copy to .env and fill in all values before running
# NEVER commit .env to git

# ── Database ───────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://attendiq:yourpassword@localhost:5432/attendiq_db

# ── JWT ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_hex_string_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Device auth ────────────────────────────────────────────────────
# Must match ERP_API_KEY in the Pi's .env
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=replace_with_another_random_string

# ── First admin (only used on first run) ──────────────────────────
FIRST_ADMIN_EMAIL=admin@yourcompany.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=System Administrator

# ── CORS (frontend URLs that can call this API) ────────────────────
# Comma-separated list
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Attendance rules ───────────────────────────────────────────────
DEFAULT_SHIFT_START=09:00
LATE_GRACE_MINUTES=15
MIN_SHIFT_MINUTES=5

# ── Notifications (Phase 5 — fill in when needed) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFY_FROM_EMAIL=noreply@yourcompany.com

# ── Dev ────────────────────────────────────────────────────────────
DEBUG=false
